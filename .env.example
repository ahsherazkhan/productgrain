# Public site identity
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_MARKET_DEFAULT=us

# Qualified-lead booking destinations (preferred, server-only)
BOOKING_URL_DEFAULT=
BOOKING_URL_US=
BOOKING_URL_UK=

# Compatibility aliases requested by the build brief. Keep empty when using
# the server-only variables above; NEXT_PUBLIC values are not access controls.
NEXT_PUBLIC_BOOKING_URL_DEFAULT=
NEXT_PUBLIC_BOOKING_URL_US=
NEXT_PUBLIC_BOOKING_URL_UK=

# Lead storage: "supabase" or "webhook"
LEAD_STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional CRM webhook destination
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Transactional email
RESEND_API_KEY=
EMAIL_FROM="NeedFoundry <hello@example.com>"
INTERNAL_LEAD_EMAIL=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Meta Pixel and Conversions API
NEXT_PUBLIC_META_PIXEL_ID=
META_ACCESS_TOKEN=
META_DATASET_ID=
META_TEST_EVENT_CODE=
# Optional override; defaults to the implementation's tested Graph API version
META_API_VERSION=

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public social links
NEXT_PUBLIC_FOUNDER_LINKEDIN=
NEXT_PUBLIC_COMPANY_LINKEDIN=
NEXT_PUBLIC_CONTACT_EMAIL=

# Privacy and abuse-prevention defaults
LEAD_RETENTION_DAYS=365
LEAD_RATE_LIMIT_WINDOW_SECONDS=60
LEAD_RATE_LIMIT_MAX_REQUESTS=5
